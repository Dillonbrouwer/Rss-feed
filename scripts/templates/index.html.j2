<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }}</title>
<style>
  :root { color-scheme: light dark; --fg:#1d1d1f; --bg:#fafafa; --muted:#6b6b70; --card:#fff; --line:#e3e3e8; --accent:#2a5bd7; }
  @media (prefers-color-scheme: dark) { :root { --fg:#e8e8ea; --bg:#121214; --muted:#9a9aa2; --card:#1c1c20; --line:#2c2c33; --accent:#7aa2ff; } }
  body { margin:0; font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--fg); }
  header, main { max-width: 860px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 1.6rem; margin: .5rem 0 0; }
  .meta { color: var(--muted); font-size: .9rem; }
  .controls { display:flex; flex-wrap:wrap; gap:8px; margin: 12px 0; }
  .controls input, .controls select { font: inherit; padding:6px 10px; border:1px solid var(--line); border-radius:6px; background:var(--card); color:var(--fg); }
  .controls input { flex:1 1 220px; }
  .chips { display:flex; flex-wrap:wrap; gap:6px; margin-bottom: 12px; }
  .chip { font: inherit; font-size:.85rem; padding:4px 10px; border:1px solid var(--line); border-radius:999px; background:var(--card); color:var(--fg); cursor:pointer; }
  .chip[aria-pressed="true"] { background:var(--accent); border-color:var(--accent); color:#fff; }
  article { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px 14px; margin-bottom:10px; }
  article h2 { font-size: 1.05rem; margin: 0 0 4px; }
  article h2 a { color: var(--accent); text-decoration: none; }
  .excerpt { margin: 6px 0; }
  .tags span { font-size:.75rem; color:var(--muted); margin-right:8px; }
  .row { display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; }
  button.copy { font: inherit; font-size:.8rem; padding:4px 10px; border-radius:6px; border:1px solid var(--line); background:transparent; color:var(--fg); cursor:pointer; }
  .stale { background:#fff4d6; color:#5a4300; border-radius:8px; padding:8px 12px; margin: 12px 0; font-size:.9rem; }
  .empty { color: var(--muted); text-align:center; padding: 24px 0; }
</style>
</head>
<body>
<header>
  <h1>{{ site_title }}</h1>
  <div class="meta">Updated {{ generated }} · {{ articles|length }} articles from the last {{ archive_days }} days</div>
</header>
<main>
  {% if stale %}
  <div class="stale">Feeds with no successful fetch in the last {{ stale_feed_hours }} hours:
    {% for s in stale %}{{ s.name }} (last: {{ s.last }}){% if not loop.last %}, {% endif %}{% endfor %}
  </div>
  {% endif %}

  <div class="controls">
    <input id="q" type="search" placeholder="Search titles, outlets, excerpts">
    <select id="outlet">
      <option value="">All outlets</option>
      {% for o in outlets %}<option value="{{ o }}">{{ o }}</option>{% endfor %}
    </select>
  </div>

  <div class="chips" id="topics">
    <button class="chip" data-topic="" aria-pressed="true">All</button>
    {% for t in topics %}<button class="chip" data-topic="{{ t }}" aria-pressed="false">{{ t }}</button>{% endfor %}
  </div>

  <div id="list">
  {% for a in articles %}
    <article data-outlet="{{ a.outlet }}" data-tags="{{ a.tags|join('|') }}" data-search="{{ a.search_text }}">
      <h2><a href="{{ a.link }}" target="_blank" rel="noopener">{{ a.title }}</a></h2>
      <div class="meta">{{ a.outlet }}{% if a.author %} · {{ a.author }}{% endif %} · {{ a.pub_local }}{% if a.also_reported_by %} · also reported by {{ a.also_reported_by|join(', ') }}{% endif %}</div>
      {% if a.excerpt %}<p class="excerpt">{{ a.excerpt }}</p>{% endif %}
      <div class="row">
        <div class="tags">{% for t in a.tags %}<span>#{{ t }}</span>{% endfor %}</div>
        <button class="copy" data-citation="{{ a.citation }}">Copy citation</button>
      </div>
    </article>
  {% else %}
    <p class="empty">No articles yet. The first fetch may still be running.</p>
  {% endfor %}
  </div>
  <p class="empty" id="none" hidden>No articles match these filters.</p>
</main>
<script>
(function () {
  var topic = "", q = document.getElementById("q"), outlet = document.getElementById("outlet");
  var cards = Array.prototype.slice.call(document.querySelectorAll("#list article"));
  var none = document.getElementById("none");

  function apply() {
    var term = q.value.trim().toLowerCase(), o = outlet.value, shown = 0;
    cards.forEach(function (c) {
      var tags = c.dataset.tags ? c.dataset.tags.split("|") : [];
      var ok = (!topic || tags.indexOf(topic) !== -1)
            && (!o || c.dataset.outlet === o)
            && (!term || c.dataset.search.indexOf(term) !== -1);
      c.hidden = !ok; if (ok) shown++;
    });
    none.hidden = shown !== 0 || cards.length === 0;
  }

  document.querySelectorAll("#topics .chip").forEach(function (b) {
    b.addEventListener("click", function () {
      topic = b.dataset.topic;
      document.querySelectorAll("#topics .chip").forEach(function (x) {
        x.setAttribute("aria-pressed", x === b ? "true" : "false");
      });
      apply();
    });
  });
  q.addEventListener("input", apply);
  outlet.addEventListener("change", apply);

  document.querySelectorAll("button.copy").forEach(function (b) {
    b.addEventListener("click", function () {
      var text = b.dataset.citation, done = function () {
        var old = b.textContent; b.textContent = "Copied"; setTimeout(function () { b.textContent = old; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { window.prompt("Copy citation:", text); });
      } else {
        window.prompt("Copy citation:", text);
      }
    });
  });
})();
</script>
</body>
</html>
